---
import Layout from "../../layouts/Layout.astro"
import PostList from "../../components/PostList.astro"
import { getPosts } from "../../lib/content"

const posts = await getPosts()
---

<Layout title="Blog" description="Notas y artículos sobre desarrollo de software.">
  <h1 class="text-3xl font-bold tracking-tight">Blog</h1>
  <p class="mt-2 text-zinc-600 dark:text-zinc-400">Notas sobre lo que voy aprendiendo.</p>
  <div class="mt-6">
    <PostList posts={posts} />
  </div>
</Layout>
