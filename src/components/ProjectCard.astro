---
import { Image } from "astro:assets"
import type { CollectionEntry } from "astro:content"

interface Props {
  project: CollectionEntry<"projects">
}

const { title, description, image, url, repo, tags } = Astro.props.project.data
---

<article
  class="group flex flex-col overflow-hidden rounded-xl border border-zinc-200 transition-shadow hover:shadow-lg dark:border-zinc-800"
>
  <Image
    src={image}
    alt={`Captura de ${title}`}
    widths={[400, 800]}
    sizes="(min-width: 768px) 400px, 100vw"
    class="aspect-video w-full object-cover object-top"
  />
  <div class="flex flex-1 flex-col gap-3 p-5">
    <h3 class="text-lg font-semibold">{title}</h3>
    <p class="flex-1 text-sm text-zinc-600 dark:text-zinc-400">{description}</p>
    {
      tags.length > 0 && (
        <ul class="flex flex-wrap gap-2">
          {tags.map((tag) => (
            <li class="rounded-full bg-zinc-100 px-2.5 py-0.5 text-xs dark:bg-zinc-800">{tag}</li>
          ))}
        </ul>
      )
    }
    <div class="flex gap-4 text-sm font-medium">
      {url && <a href={url} target="_blank" rel="noopener" class="text-brand hover:underline">Ver proyecto</a>}
      {repo && <a href={repo} target="_blank" rel="noopener" class="hover:underline">Código</a>}
    </div>
  </div>
</article>
